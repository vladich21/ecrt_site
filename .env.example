# Публичный origin сайта (без слэша в конце)
NEXT_PUBLIC_SITE_URL=https://ecrt.ru

# ID счётчика Яндекс.Метрики (загружается только после согласия на cookie)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# URL политики обработки персональных данных (PDF или страница)
# Если не задано — используется страница /privacy-policy на сайте
# Пример PDF: https://ecrt.ru/personal_data.pdf
NEXT_PUBLIC_PRIVACY_POLICY_URL=
