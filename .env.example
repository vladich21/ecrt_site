# Публичный origin сайта (без слэша в конце).
# На Vercel: Settings → Environment Variables → Production (+ Preview).
# Если не задано — в коде используется https://ecrt.ru
NEXT_PUBLIC_SITE_URL=https://ecrt.ru

# Яндекс.Метрика: числовой ID счётчика (например 12345678).
# Загружается только после «Принять» в баннере cookie.
# Получить: metrika.yandex.ru → ваш сайт → Настройки → код счётчика → id=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Необязательно: внешняя ссылка на PDF политики (иначе /privacy-policy)
NEXT_PUBLIC_PRIVACY_POLICY_URL=
